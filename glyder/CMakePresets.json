{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "desktop",
      "displayName": "glyder desktop viewer, tools and tests (Vulkan, X11)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/glyder-desktop",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "GLYDER_BUILD_VIEWER": "ON" }
    },
    {
      "name": "quest",
      "displayName": "glyder for Meta Quest (arm64 APK)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/glyder-quest",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-29",
        "ANDROID_STL": "c++_static",
        "GLYDER_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "desktop", "configurePreset": "desktop" },
    { "name": "quest", "configurePreset": "quest" }
  ],
  "testPresets": [
    { "name": "desktop", "configurePreset": "desktop", "output": { "outputOnFailure": true } }
  ]
}
