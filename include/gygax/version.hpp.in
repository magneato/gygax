#define GYGAX_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define GYGAX_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define GYGAX_VERSION_STRING "@PROJECT_VERSION@"
