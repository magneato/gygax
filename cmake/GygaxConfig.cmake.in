@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/GygaxTargets.cmake")

function(gygax_add_plugin name)
    cmake_parse_arguments(ARG "" "" "SOURCES" ${ARGN})
    add_library(${name} MODULE ${ARG_SOURCES})
    target_link_libraries(${name} PRIVATE gygax::sdk)
    set_target_properties(${name} PROPERTIES PREFIX "" CXX_VISIBILITY_PRESET hidden C_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
endfunction()

check_required_components(Gygax)
